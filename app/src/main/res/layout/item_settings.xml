<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="72dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingLeft="20dp" android:paddingRight="20dp"
    android:background="?attr/selectableItemBackground">
    <TextView android:id="@+id/item_icon" android:layout_width="40dp"
        android:layout_height="40dp" android:gravity="center"
        android:textSize="20sp" android:background="@drawable/icon_bg"
        android:layout_marginEnd="16dp"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical">
        <TextView android:id="@+id/item_title" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="16sp"
            android:textColor="?attr/colorOnSurface"/>
        <TextView android:id="@+id/item_subtitle" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:textSize="13sp"
            android:textColor="?attr/colorControlNormal" android:layout_marginTop="2dp"/>
    </LinearLayout>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="›" android:textSize="22sp" android:textColor="?attr/colorControlNormal"/>
</LinearLayout>
